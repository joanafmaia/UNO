# ID da aplicação Discord (Developer Portal → OAuth2)
VITE_DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_ID=your_discord_application_id

# Secret OAuth2 (nunca expor no frontend)
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Bot (Portal → Bot → Reset Token) — para registar /playuno
DISCORD_BOT_TOKEN=your_discord_bot_token

# Public Key (Portal → General Information) — para verificar interacções
DISCORD_PUBLIC_KEY=your_discord_public_key

# Porta do backend Express + Socket.io
PORT=3001

# true = permite jogar no browser fora do Discord (utilizador mock).
# O servidor só aceita mock a partir do socket loopback (127.0.0.1 / ::1),
# nunca a partir de X-Forwarded-For. Em produção (NODE_ENV=production)
# o mock fica sempre desligado, mesmo com esta flag a true.
ALLOW_DEV_MOCK=true

# true = HMR do Vite na porta 443 (túnel Discord / Cloudflare).
# Deixa false para desenvolvimento local em http://localhost:5173
VITE_DISCORD_TUNNEL=false

# MongoDB — local / Docker: mongodb://127.0.0.1:27017/uno
# Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/uno
MONGODB_URI=mongodb://127.0.0.1:27017/uno
# Opcional: força o nome da base se o URI não o tiver
# MONGODB_DB=uno
